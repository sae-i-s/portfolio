---
// Header: site navigation, previously inlined in BaseLayout
// i18n-ready: nav labels are grouped as const variables so they can move to a locale dictionary later
const NAV_HOME_LABEL = 'SIS'; // i18n-ready
const NAV_ABOUT_LABEL = 'About'; // i18n-ready
const NAV_WORKS_LABEL = 'Works'; // i18n-ready
// const NAV_CONTACT_LABEL = 'Contact'; // i18n-ready, after adding contact form
---

<header class="fixed top-0 left-0 z-50 w-full bg-background/90 backdrop-blur-md">
	<nav class="flex items-center justify-between px-8 py-6 md:px-16">
		<div class="flex-shrink-0">
			<a href="/" class="font-heading text-lg font-semibold text-accent">
				{NAV_HOME_LABEL}
			</a>
		</div>
		<ul class="flex gap-8 font-body text-sm">
			<li>
				<a href="#about" class="hover:text-accent transition-colors">{NAV_ABOUT_LABEL}</a>
			</li>
			<li>
				<a href="#works" class="hover:text-accent transition-colors">{NAV_WORKS_LABEL}</a>
			</li>
		</ul>
	</nav>
</header>
